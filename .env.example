PORT=3000
YANDEX_ROUTING_API_KEY=

# Separate, read-only business observer; never use IO Planner's consumer group.
KAFKA_OBSERVER_ENABLED=false
KAFKA_BROKERS=
KAFKA_CONSUMER_GROUP=routing-lab-observer
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_CA_LOCATION=
KAFKA_SSL=false
KAFKA_ORDERS_TOPIC=delivery-io.order-status
KAFKA_COURIERS_TOPIC=courier-io.status
KAFKA_FROM_BEGINNING=false
KAFKA_ALLOW_COOKING_START_DEADLINE=false
OBSERVER_COURIER_MAX_ORDERS=3
OBSERVER_COURIER_MAX_SUM=300000
# SQLITE_PATH=data/observer.sqlite
